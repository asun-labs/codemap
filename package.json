{
  "name": "codemap-agents",
  "version": "0.1.0",
  "description": "CodeMap 代码地图 —— 看清一个工程的结构，画成图。MCP server + CLI（P0：doctor / check_index / 镜像 ETL / coverage / get）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "codemap": "dist/cli.js",
    "codemap-mcp": "dist/mcp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/mirror.test.ts tests/coverage.test.ts tests/projections.test.ts",
    "smoke": "node dist/cli.js doctor ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "cross-spawn": "^7.0.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
